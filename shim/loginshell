#!/bin/sh
# loginshell - the login shell for a host with no /dev/ptmx.
#
# The sshd that serves the session is dynamic, so it can be interposed, but it
# has no kernel pty to allocate: /dev/ptmx does not exist and /dev is not
# writable. It refuses the client's pty request and continues over pipes. This
# hands that session to the userspace pty (fakepty.so) and the line discipline
# (errandsh), which provide the echo, editing and prompt the kernel would have.
#
# sshd strips LD_PRELOAD from the session, so this puts the passwd shim back
# for the whole session: without it, `whoami`, `id` and `ls -l` cannot resolve
# uid 966 because /etc/passwd does not exist.
#
# Generated by `cfrs net ts-sshd`; @DIR@, @FAKEPWD@ and @PASSWD@ are absolute
# paths.
DIR=@DIR@
PASSWD_SHIM=@FAKEPWD@
PASSWD_FILE=@PASSWD@
SANDHOME_FAKEPTY="$DIR/fakepty.so"
SANDHOME_FAKEPTY_TERM="${SANDHOME_FAKEPTY_TERM:-xterm-256color}"
SANDHOME_PASSWD="$PASSWD_FILE"
LD_PRELOAD="$PASSWD_SHIM${LD_PRELOAD:+ $LD_PRELOAD}"
export SANDHOME_FAKEPTY SANDHOME_FAKEPTY_TERM SANDHOME_PASSWD LD_PRELOAD
exec "$DIR/faketty" "$DIR/errandsh" "$@"
