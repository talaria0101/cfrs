#!/bin/sh
# Fake getent for a host with no /etc/passwd.
#
# tailscaled is a static Go binary, so LD_PRELOAD cannot interpose its libc.
# Its osuser package shells out to `getent` to resolve a local login and the
# login shell, and `id` (see tsid) to resolve group ids. This script answers
# `getent passwd` and `getent group` from files we control, which is enough
# for Tailscale SSH to accept a login on a host whose /etc is read-only.
#
# Put this directory first on tailscaled's PATH. Generated by
# `cfrs net ts-shims`; @PASSWD@ and @GROUP@ are absolute paths.
passwd_db=@PASSWD@
group_db=@GROUP@

db="${1:-}"
case "$db" in
  passwd)
    shift
    [ "${1:-}" = "--" ] && shift
    if [ "$#" -eq 0 ]; then cat "$passwd_db"; exit 0; fi
    line=$(awk -F: -v k="$1" '$1==k || $3==k {print; found=1; exit} END{exit !found}' "$passwd_db")
    [ -n "$line" ] && { printf '%s\n' "$line"; exit 0; }
    exit 2 ;;
  group)
    shift
    [ "${1:-}" = "--" ] && shift
    if [ "$#" -eq 0 ]; then cat "$group_db"; exit 0; fi
    line=$(awk -F: -v k="$1" '$1==k || $3==k {print; found=1; exit} END{exit !found}' "$group_db")
    [ -n "$line" ] && { printf '%s\n' "$line"; exit 0; }
    exit 2 ;;
  *) exit 2 ;;
esac
