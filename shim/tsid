#!/bin/sh
# Fake id for a host with no /etc/group.
#
# tailscale's osuser.GetGroupIds runs `id -Gz <user>` first, and only falls
# back to reading /etc/group (absent here, and /etc is read-only under
# Landlock) if that fails. Answering just this call keeps the fallback from
# running. Put this directory first on tailscaled's PATH.
#
# Generated by `cfrs net ts-shims`; @PASSWD@ and @GID@ are absolute paths and
# a fallback group id.
passwd_db=@PASSWD@
fallback_gid=@GID@

z=0
case "${1:-}" in
  -Gz) z=1; shift ;;
  -G)  shift ;;
  *)   exec /usr/bin/id "$@" ;;
esac

name="${1:-}"
gid=$(awk -F: -v k="$name" '$1==k || $3==k {print $4; found=1; exit} END{exit !found}' "$passwd_db")
[ -n "$gid" ] || gid="$fallback_gid"
if [ "$z" = 1 ]; then printf '%s\0' "$gid"; else printf '%s\n' "$gid"; fi
